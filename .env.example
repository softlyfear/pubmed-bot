# Telegram
BOT_TOKEN=

# NCBI E-utilities (бесплатный API)
NCBI_API_KEY=
NCBI_EMAIL=
NCBI_TOOL=pubmed-bot

# DeepL API Free (классический MT, не LLM)
DEEPL_AUTH_KEY=

# OpenAI Chat Completions (только rewriter поискового term, не статьи)
OPENAI_API_KEY=
OPENAI_MODEL=

# SQLite (файл на диске, пароля нет). В Docker Compose переопределяется на /data/pubmed.db
SQLITE_PATH=./data/pubmed.db

# Опционально (есть дефолты в коде)
# LOG_LEVEL=INFO
# NCBI_MAX_RPS=8
# USER_SEARCH_PER_MIN=10
# USER_OPEN_PER_MIN=20
# SUBSCRIPTION_HOUR_UTC=6
# DEEPL_MIN_CHARS_REMAINING=20000
